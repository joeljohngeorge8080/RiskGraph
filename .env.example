# Copy to .env. Never commit .env. Values here are placeholders, not secrets.
RISKGRAPH_ENV=dev
RISKGRAPH_LOG_LEVEL=INFO
RISKGRAPH_LOG_JSON=true
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
RISKGRAPH_SECRET_KEY=change-me-to-48-random-characters-before-first-run
RISKGRAPH_CORS_ORIGINS=["http://localhost:5173"]
RISKGRAPH_API_DOCS_ENABLED=true

# Used by docker-compose to configure postgres/redis and derive RISKGRAPH_*_URL.
POSTGRES_USER=riskgraph
POSTGRES_PASSWORD=riskgraph
POSTGRES_DB=riskgraph
REDIS_PASSWORD=riskgraph

# Only needed when running the backend on the host instead of in compose:
# RISKGRAPH_DATABASE_URL=postgresql+psycopg://riskgraph:riskgraph@localhost:5432/riskgraph
# RISKGRAPH_REDIS_URL=redis://:riskgraph@localhost:6379/0

# Scanning (MVP). Compose/worker image set the scanner paths itself; these matter
# only for host runs (`make api-local` / `make worker-local` override them too).
# RISKGRAPH_DATA_DIR=/var/lib/riskgraph
# RISKGRAPH_MAX_ACTIVE_SCANS=3
# RISKGRAPH_ENRICHMENT_ENABLED=true     # EPSS (api.first.org) + CISA KEV lookups
# RISKGRAPH_KEEP_WORKSPACES=false       # keep clones after a scan (debugging only)

# Host ports published by docker compose (change if something else uses them).
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
FRONTEND_PORT=5173
