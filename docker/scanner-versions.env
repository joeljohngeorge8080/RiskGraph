# Single source of truth for scanner versions (ADR-0009). Read by
# infrastructure/scripts/install-scanners.sh and docker/backend.Dockerfile.
# Bumping a version means re-recording backend/tests/fixtures/scanners/<name>/.
TRIVY_VERSION=0.76.0
GITLEAKS_VERSION=8.30.1
SEMGREP_VERSION=1.182.0
CHECKOV_VERSION=3.3.30
# semgrep/semgrep-rules commit used when the semgrep.dev registry is unreachable.
SEMGREP_RULES_COMMIT=17e31e11ebac99fb7dfe1cd288f7a32151b6f3f9
SYFT_VERSION=1.54.1
